# =====================================================================
# CareerAI - Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit your actual .env file or production secrets to Git.
# =====================================================================

# --- Application Metadata & Environment ---
APP_NAME="AI Job Prediction and Career Recommendation System"
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# --- Security & JWT Authentication ---
# Generate a secure 32+ character key locally:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_jwt_signing_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configuration ---
# Leave MONGODB_URI empty to automatically use the embedded SQLite database (backend/data/careerai.db).
# To use MongoDB Atlas (Free M0 cluster), provide your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_job_prediction?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=ai_job_prediction
SQLITE_DB_PATH=backend/data/careerai.db

# --- Local Ollama Career Assistant (Optional) ---
# CareerAI includes a built-in Deterministic Guided Career Advisor that runs
# instantly with zero external dependencies. To enable optional local Ollama LLM:
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# --- CORS Configuration ---
# Comma-separated list of allowed frontend origins:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
