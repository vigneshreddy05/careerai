*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
*.pem
*.key

# SQLite & Local Application Databases
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite*

# Large Model Binaries, Weights & Checkpoints (>100MB)
*.safetensors
*.bin
*.onnx
*.pt
*.pth
backend/ml/saved_models/epoch_checkpoints/
backend/ml/saved_models/benchmark_checkpoint/
backend/ml/saved_models/distilbert_job_classifier/*.safetensors
backend/ml/saved_models/all_minilm_l6_v2/*.safetensors
backend/ml/datasets/raw/
backend/ml/datasets/processed/

# IDE, Editor & Operating System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
